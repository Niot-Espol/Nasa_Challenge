  m_Script: {fileID: 11500000, guid: 28c3e562645bb4c13bba240885e23578, type: 3}
  m_Name: Hub_Bimo
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: 1
    text: "Entonces... \xBFviajaremos millones de kil\xF3metros para recoger piedras?"
  - speaker: 1
    text: "\xA1Ah, ya s\xE9! Las rocas pueden guardar la historia de un planeta.
      \xA1Las piedras m\xE1s importantes de mi carrera espacial!"
  - speaker: 1
    text: "Un consejo: los paneles solares son ligeros y baratos... pero en Marte
      hay tormentas de polvo. Pi\xE9nsalo bien."
