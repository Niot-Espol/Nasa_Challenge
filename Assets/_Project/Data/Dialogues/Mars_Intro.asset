  m_Script: {fileID: 11500000, guid: 28c3e562645bb4c13bba240885e23578, type: 3}
  m_Name: Mars_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: 1
    text: "\xA1Aterrizamos en Jezero, comandante! Hace miles de millones de a\xF1os
      aqu\xED hubo un lago."
  - speaker: 1
    text: "Tenemos 4 minutos de operaci\xF3n. Moverse y escanear gasta energ\xEDa:
      vigila la barra de arriba."
  - speaker: 1
    text: "Busca los tres puntos cient\xEDficos. Ac\xE9rcate y presiona E para escanear.
      \xA1Vamos!"
